{:paths ["src" "src/dev" "src/catalog"]
 :deps {org.clojure/clojure {:mvn/version "1.11.3"}
 
        ;; --- Datomic: use whichever client you already depend on in your app.
        com.datomic/local {:mvn/version "1.0.277"}

  
        ;; --- HTML generation
        hiccup/hiccup {:mvn/version "2.0.0"}
 
        ;; --- HTML -> PDF rendering (pure JVM, no external binaries needed)
        io.github.openhtmltopdf/openhtmltopdf-core   {:mvn/version "1.1.37"}
        io.github.openhtmltopdf/openhtmltopdf-pdfbox {:mvn/version "1.1.37"}}
 
 :aliases
 {:generate-catalog
  {:exec-fn catalog.cli/-main
   :exec-args {}}}}

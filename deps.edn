{:paths ["src" "resources"]

 :deps {org.clojure/clojure       {:mvn/version "1.11.1"}

        ;; Datomic — dev-local for free local development (no AWS needed),
        ;; client-cloud for talking to a real Datomic Cloud system.
        ;; Pin these to whatever's current on the Datomic downloads page —
        ;; versions below are illustrative, not guaranteed latest.
        com.datomic/local        {:mvn/version "1.0.277"}
        com.datomic/client-cloud {:mvn/version "1.0.130"}

        ;; API layer
        metosin/reitit             {:mvn/version "0.7.0"}
        metosin/muuntaja           {:mvn/version "0.6.10"}
        ring/ring-jetty-adapter    {:mvn/version "1.12.1"}
        ring/ring-core             {:mvn/version "1.12.1"}

        ;; Payments — check Maven Central for whatever's newest before
        ;; installing; pin below is illustrative, same as the Datomic libs.
        com.stripe/stripe-java     {:mvn/version "24.0.0"}
        org.clojure/data.json      {:mvn/version "2.5.0"}}

        ;; ---- HTML generation
        hiccup/hiccup              {:mvn/version "2.0.0-RC3"}

        ;; ---- HTML -> PDF rendering (pure JVM, no external binaries needed)
        io.github.openhtmltopdf/openhtmltopdf-core   {:mvn/version "1.0.10"}
        io.github.openhtmltopdf/openhtmltopdf-pdfbox {:mvn/version "1.0.10"}
 
 :aliases
 {:dev {:extra-paths ["dev"]}
  :run {:main-opts ["-m" "store.core"]}
  :generate-catalog {:exec-fn catalog.cli/-main
                     :exec-args {}}}}

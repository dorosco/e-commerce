(ns shop.admin.handler
  "Routes and middleware for the admin UI (served on port 8080, behind Caddy)."
  (:require [clojure.string :as str]
            [datomic.client.api :as d]
            [reitit.ring :as ring]
            [ring.adapter.jetty :as jetty]
            [ring.middleware.anti-forgery :refer [wrap-anti-forgery]]
            [ring.middleware.multipart-params :refer [wrap-multipart-params]]
            [ring.middleware.multipart-params.byte-array :refer [byte-array-store]]
            [ring.middleware.params :refer [wrap-params]]
            [ring.middleware.resource :refer [wrap-resource]]
            [ring.middleware.session :refer [wrap-session]]
            [ring.middleware.session.cookie :refer [cookie-store]]
            [shop.admin.audit :as audit]
            [shop.admin.auth :as auth]
            [shop.admin.products :as products]
            [shop.admin.views :as views])
  (:import (java.time LocalDate ZoneId)))

(def ^:private session-max-age-ms (* 8 60 60 1000))
(def ^:private max-body (* 3 1024 1024))

;; ---------------------------------------------------------------------------
;; Small helpers
;; ---------------------------------------------------------------------------

(defn- html [body & [status]]
  {:status (or status 200) :headers {"Content-Type" "text/html; charset=utf-8"} :body body})

(defn- redirect [to] {:status 303 :headers {"Location" to} :body ""})

(defn- client-ip
  "Caddy overwrites X-Forwarded-For with the real client address, and the app
   port is not published, so the header can be trusted here."
  [req]
  (or (some-> (get-in req [:headers "x-forwarded-for"]) (str/split #",") first str/trim not-empty)
      (:remote-addr req)))

(defn- htmx-partial? [req]
  (and (get-in req [:headers "hx-request"])
       (not (get-in req [:headers "hx-history-restore-request"]))))

;; ---------------------------------------------------------------------------
;; Middleware
;; ---------------------------------------------------------------------------

(defn- wrap-security-headers [handler]
  (fn [req]
    (some-> (handler req)
            (update :headers merge
                    {"X-Content-Type-Options" "nosniff"
                     "X-Frame-Options"        "DENY"
                     "Referrer-Policy"        "same-origin"
                     "Cache-Control"          "no-store"
                     "Content-Security-Policy"
                     "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; form-action 'self'"}))))

(defn- wrap-errors [handler]
  (fn [req]
    (try
      (handler req)
      (catch Throwable t
        (.printStackTrace t)
        (html "<h1>Error interno</h1><p>Revisa los logs del servidor.</p>" 500)))))

(defn- wrap-body-limit
  "Rejects oversized uploads before they are parsed into memory."
  [handler]
  (fn [req]
    (let [len (:content-length req)
          multipart? (some-> (get-in req [:headers "content-type"]) (str/starts-with? "multipart/"))]
      (cond
        (and len (> len max-body))  (html "Archivo demasiado grande (máx. 3 MB)." 413)
        (and multipart? (nil? len)) (html "Falta Content-Length." 411)
        :else (handler req)))))

;; ---------------------------------------------------------------------------
;; Login / logout
;; ---------------------------------------------------------------------------

(defn- login-post [conn]
  (fn [req]
    (let [fp       (:form-params req)
          raw-user (str/lower-case (str/trim (str (get fp "username"))))
          username (subs raw-user 0 (min 64 (count raw-user)))   ; bounded: it is a rate-limiter key
          password (str (get fp "password"))
          ip       (client-ip req)
          now      (System/currentTimeMillis)]
      (if-let [wait (auth/retry-after ip username now)]
        (-> (html (views/login-page (str "Demasiados intentos. Espera " (inc (quot wait 60)) " minuto(s).")) 429)
            (assoc-in [:headers "Retry-After"] (str wait)))
        (if-let [user (and (<= (count password) 200)
                           (auth/authenticate (d/db conn) username password))]
          (do (auth/clear-failures! ip username)
              ;; a fresh session replaces the pre-login one (no session fixation)
              (assoc (redirect "/products") :session {:user user :logged-in-at now}))
          (do (auth/record-failure! ip username now)
              (html (views/login-page "Usuario o contraseña incorrectos.") 401)))))))

;; ---------------------------------------------------------------------------
;; Product handlers
;; ---------------------------------------------------------------------------

(defn- products-handler [conn]
  (fn [req]
    (let [qp     (:query-params req)
          q      (get qp "q" "")
          status (get qp "status" "")
          page   (some-> (get qp "page") parse-long)
          data   (assoc (products/list-products (d/db conn) {:q q :status status :page page})
                        :q q :status status)]
      (html (if (htmx-partial? req)
              (views/fragment (views/products-fragment data))
              (views/products-page {:user (:user req)} data))))))

(defn- with-product [conn req f]
  (if-let [p (products/get-product (d/db conn) (get-in req [:path-params :sku]))]
    (f p)
    (html "Producto no encontrado" 404)))

(defn- edit-handler [conn]
  (fn [req] (with-product conn req #(html (views/fragment (views/product-edit-row %))))))

(defn- row-handler [conn]
  (fn [req] (with-product conn req #(html (views/fragment (views/product-row %))))))

(defn- save-handler [conn]
  (fn [req]
    (with-product
      conn req
      (fn [p]
        (let [fp    (:form-params req)
              sku   (:product/sku p)
              price (products/parse-price-cents (get fp "price"))
              stock (products/parse-stock (get fp "stock"))
              edit  (fn [p msg] (html (views/fragment (views/product-edit-row p msg))))
              fresh #(products/get-product (d/db conn) sku)]
          (cond
            (nil? price) (edit p "Precio inválido (ej. 49.90)")
            (nil? stock) (edit p "Stock inválido (entero ≥ 0)")
            :else
            ;; Build the change against the values the user SAW (hidden fields), so a
            ;; concurrent edit makes the compare-and-set fail instead of being overwritten.
            (let [seen (assoc p :product/price-cents (some-> (get fp "old-price") parse-long)
                                :product/stock       (some-> (get fp "old-stock") parse-long))
                  tx   (products/change-tx seen {:price-cents price :stock stock})]
              (try
                (products/transact! conn (:user req) (str "inline edit " sku) tx)
                (html (views/fragment (views/product-row (fresh))))
                (catch clojure.lang.ExceptionInfo e
                  (if (products/conflict? e)
                    (edit (fresh) "Alguien modificó este producto; se muestran los valores actuales.")
                    (throw e)))))))))))

(defn- toggle-handler [conn]
  (fn [req]
    (with-product
      conn req
      (fn [p]
        (let [sku (:product/sku p)
              tx  (products/change-tx p {:active? (not (true? (:product/active? p)))})]
          (try
            (products/transact! conn (:user req) (str "toggle active " sku) tx)
            (catch clojure.lang.ExceptionInfo e
              (when-not (products/conflict? e) (throw e))))
          (html (views/fragment (views/product-row (products/get-product (d/db conn) sku)))))))))

(defn- history-handler [conn]
  (fn [req]
    (let [sku (get-in req [:path-params :sku])]
      (html (views/history-page {:user (:user req)} sku (audit/product-history (d/db conn) sku 200))))))

(defn- audit-handler [conn]
  (fn [req]
    (html (views/audit-page {:user (:user req)} (audit/recent-changes (d/db conn) 100)))))

;; ---------------------------------------------------------------------------
;; Import / export
;; ---------------------------------------------------------------------------

(defn- export-handler [conn]
  (fn [req]
    (let [sep (if (= ";" (get-in req [:query-params "sep"])) \; \,)]
      {:status  200
       :headers {"Content-Type"        "text/csv; charset=utf-8"
                 "Content-Disposition" (str "attachment; filename=\"productos-"
                                            (LocalDate/now (ZoneId/of "America/Lima")) ".csv\"")}
       :body    (products/export-csv (d/db conn) sep)})))

(defn- import-handler [conn]
  (fn [req]
    (let [ctx  {:user (:user req)}
          file (get-in req [:multipart-params "file"])
          bs   ^bytes (:bytes file)]
      (if (or (nil? bs) (zero? (alength bs)))
        (html (views/data-page ctx "Selecciona un archivo CSV."))
        (let [plan  (products/parse-import (d/db conn) bs)
              token (when-not (:fatal plan)
                      (products/store-pending! (:user req) (:filename file) plan))]
          (html (views/import-preview-page ctx (:filename file) plan token)))))))

(defn- confirm-handler [conn]
  (fn [req]
    (html (views/import-result-page
            {:user (:user req)}
            (products/apply-pending! conn (:user req) (get-in req [:form-params "token"]))))))

;; ---------------------------------------------------------------------------
;; App
;; ---------------------------------------------------------------------------

(defn app [conn {:keys [session-key secure-cookie?]}]
  (-> (ring/ring-handler
        (ring/router
          [["/"                      {:get (fn [_] (redirect "/products"))}]
           ["/health"                {:get (fn [_] (html "ok"))}]
           ["/login"                 {:get  (fn [_] (html (views/login-page)))
                                      :post (login-post conn)}]
           ["/logout"                {:post (fn [_] (assoc (redirect "/login") :session nil))}]
           ["/products"              {:get (products-handler conn)}]
           ["/products/:sku"         {:post (save-handler conn)}]
           ["/products/:sku/edit"    {:get (edit-handler conn)}]
           ["/products/:sku/row"     {:get (row-handler conn)}]
           ["/products/:sku/toggle"  {:post (toggle-handler conn)}]
           ["/products/:sku/history" {:get (history-handler conn)}]
           ["/audit"                 {:get (audit-handler conn)}]
           ["/data"                  {:get (fn [req] (html (views/data-page {:user (:user req)})))}]
           ["/export/products.csv"   {:get (export-handler conn)}]
           ["/import"                {:post (import-handler conn)}]
           ["/import/confirm"        {:post (confirm-handler conn)}]]
          ;; Outermost first. Auth runs BEFORE body parsing, so anonymous
          ;; visitors can't make the server parse uploads.
          {:data {:middleware
                  [wrap-security-headers
                   wrap-errors
                   [wrap-session {:store        (cookie-store {:key session-key})
                                  :cookie-name  "shop-admin"
                                  :cookie-attrs {:http-only true
                                                 :secure    (boolean secure-cookie?)
                                                 :same-site :strict
                                                 :max-age   (quot session-max-age-ms 1000)}}]
                   [auth/wrap-auth conn {:public?    #(contains? #{"/login" "/health"} (:uri %))
                                         :max-age-ms session-max-age-ms}]
                   wrap-body-limit
                   wrap-params
                   [wrap-multipart-params {:store (byte-array-store)}]
                   wrap-anti-forgery]}})
        (ring/create-default-handler))
      (wrap-resource "public")))                            ; serves /htmx.min.js

(defn- hex->bytes [hex]
  (byte-array (map #(unchecked-byte (Integer/parseInt (apply str %) 16)) (partition 2 (str hex)))))

(defn start-admin!
  "session-key-hex: 32 hex chars (16 bytes), e.g. from `openssl rand -hex 16`.
   secure-cookie? must be false only for plain-http local development."
  [conn {:keys [port session-key-hex secure-cookie?] :or {port 8080 secure-cookie? true}}]
  (let [k (hex->bytes session-key-hex)]
    (when-not (= 16 (alength k))
      (throw (ex-info "ADMIN_SESSION_KEY must be 32 hex characters (openssl rand -hex 16)" {})))
    (jetty/run-jetty (app conn {:session-key k :secure-cookie? secure-cookie?})
                     {:port port :join? false})))
